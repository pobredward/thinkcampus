rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────
    // enrollmentCodes: 클라이언트 읽기/쓰기 전면 차단
    // 오직 Cloud Functions(서버)만 접근 가능
    // ─────────────────────────────────────────────────────
    match /enrollmentCodes/{code} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────
    // campuses: 로그인한 사용자 읽기만 허용 (쓰기는 Functions 경유)
    // ─────────────────────────────────────────────────────
    match /campuses/{campusId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────
    // students: guardianUids 배열에 요청자 uid가 포함된 경우만 읽기 허용
    // allowedGuardianPhoneHashes는 클라이언트에 노출 안 함 (Functions만 접근)
    // 쓰기는 Functions 경유
    // ─────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.guardianUids;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────
    // guardianLinks: 보호자(uid) ↔ 학생 ↔ 캠퍼스 연결 (구 enrollments)
    // ─────────────────────────────────────────────────────
    match /guardianLinks/{linkId} {
      allow read: if request.auth != null
        && resource.data.guardianUid == request.auth.uid;
      allow write: if false;
    }

    // 레거시 — 마이그레이션 후 데이터 없음. 클라이언트 접근 차단
    match /enrollments/{enrollmentId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────
    // shareTokens: viewReport HTTP Function이 서버에서만 읽음
    // 클라이언트 직접 접근 완전 차단
    // ─────────────────────────────────────────────────────
    match /shareTokens/{token} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────
    // reports: guardianUids 배열에 요청자 uid가 포함된 경우만 읽기 허용
    // ─────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.guardianUids;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────
    // accountDeletions: 회원 탈퇴 기록 (개인정보 없음, deleteAccount Function 만 기록)
    // ─────────────────────────────────────────────────────
    match /accountDeletions/{doc} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────
    // _ratelimit: 내부용 rate limit 카운터 (클라이언트 완전 차단)
    // ─────────────────────────────────────────────────────
    match /_ratelimit/{doc} {
      allow read, write: if false;
    }

    // programRuns / runSessions / studentProgramEnrollments — Functions(Admin) 전용
    function isGuardianOfStudent(studentId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.guardianUids;
    }

    match /programRuns/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /runSessions/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /studentProgramEnrollments/{doc} {
      allow read: if isGuardianOfStudent(resource.data.studentId);
      allow write: if false;
    }
    match /programTemplates/{doc} {
      allow read, write: if false;
    }
    match /sessionTemplates/{doc} {
      allow read, write: if false;
    }

    match /sessionAttendance/{doc} {
      allow read: if isGuardianOfStudent(resource.data.studentId);
      allow write: if false;
    }

    // staff — 직원 프로필 (Auth uid = 문서 id). 쓰기는 Admin SDK / Functions만
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
